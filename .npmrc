# TASK-53: the native tree-sitter grammars declare stale peer ranges
# (@tree-sitter-grammars/tree-sitter-kotlin@1.1.0 peers on tree-sitter ^0.22.4,
# while the go/python/etc. grammars and the runtime use the 0.25 family). They
# are ABI-compatible in practice (run together locally), so resolve peer deps
# leniently for install/ci. The tree-sitter family is the only peer group and
# is all optional.
legacy-peer-deps=true
