@startuml
package "Core Layer" as Core_Layer {
  abstract class BaseEntity {
    +{abstract} getId(): string
  }
  enum Role {
    +Admin
    +Member
  }
  interface Timestamped {
    +createdAt: Date
  }
  class "Money$" as Money_ {
    +amount: number
  }
  class UserProfile {
    +createdAt: Date
    +display(): string
    +getId(): string
    +money(): Wallet
    +role: Role
  }
  class Wallet {
    +balance: number
  }
}
UserProfile *-- Role
UserProfile ..> Wallet
UserProfile ..|> Timestamped
UserProfile --|> BaseEntity
@enduml
